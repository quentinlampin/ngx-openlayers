    "angular-eslint": "22.6.0",
    "commit-and-tag-version": "^12.5.0",
    "eslint": "^9.39.0",
    "improved-yarn-audit": "^3.0.0",
    "jsdom": "^30.1.3",
    "ng-packagr": "~22.2.4",
    "prettier": "^3.4.2",
    "ts-node": "~8.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.8"
